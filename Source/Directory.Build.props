<Project>

  <PropertyGroup>
    <!--
      Build intermediates are sent out of the mod folder. RimWorld's Workshop uploader sends the
      whole folder (SteamUGC.SetItemContent on its root, no exclusion possible): leaving obj/
      inside means publishing the 5.8 MB publicised Assembly-CSharp.dll, that is, redistributing
      the game's own code. This has to stay in a Directory.Build.props: NuGet restore reads the
      property before the csproj. The path is one level up from here, so inside the repository
      and outside Mod/ - outside Mod/ being the only real constraint.
    -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\.build\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\.build\bin\</BaseOutputPath>
  </PropertyGroup>

</Project>
