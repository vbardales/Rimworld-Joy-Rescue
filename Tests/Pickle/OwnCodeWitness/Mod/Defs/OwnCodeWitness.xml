<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- A third-party mod that serves its building from code. The giver finds the kiosk by itself
       (JoyRescueOwnCode.JoyGiver_Kiosk), so no thingDefs lists it: seen from XML alone the kiosk is an
       orphan, and only the presence of a JoyGiver class in this mod's own assembly tells Joy Rescue
       that it may not be. Rescuing it anyway makes two activities compete for one building, which is
       what F05 lets a scenario observe. -->
  <ThingDef ParentName="BuildingBase">
    <defName>JoyRescueOwnCode_Kiosk</defName>
    <label>own-code kiosk</label>
    <description>Test witness: a building served by its own mod's code.</description>
    <graphicData>
      <texPath>Things/Building/Joy/Telescope</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,1)</interactionCellOffset>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.15</fillPercent>
    <socialPropernessMatters>true</socialPropernessMatters>
    <statBases>
      <MaxHitPoints>75</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <JoyGainFactor>1</JoyGainFactor>
    </statBases>
    <building>
      <joyKind>Gaming_Cerebral</joyKind>
    </building>
  </ThingDef>

  <JobDef>
    <defName>JoyRescueOwnCode_Use</defName>
    <driverClass>JobDriver_WatchBuilding</driverClass>
    <reportString>using the own-code kiosk.</reportString>
    <joyDuration>4000</joyDuration>
    <joyMaxParticipants>1</joyMaxParticipants>
    <joyGainRate>1.0</joyGainRate>
    <joyKind>Gaming_Cerebral</joyKind>
  </JobDef>

  <JoyGiverDef>
    <defName>JoyRescueOwnCode_Giver</defName>
    <giverClass>JoyRescueOwnCode.JoyGiver_Kiosk</giverClass>
    <baseChance>2</baseChance>
    <jobDef>JoyRescueOwnCode_Use</jobDef>
    <joyKind>Gaming_Cerebral</joyKind>
    <requiredCapacities>
      <li>Sight</li>
      <li>Manipulation</li>
    </requiredCapacities>
  </JoyGiverDef>
</Defs>
