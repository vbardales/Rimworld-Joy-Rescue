<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Six arrangements for the guards of the common fix set, all on the type Gaming_Cerebral with the
       audited vanilla giver and driver, so that the only thing that differs is what a guard looks at:
         Clean      one activity, one job, one building            -> the set may correct it
         Shared     two activities, one job, one building; only one has a rule -> the shared-job guard refuses it
         Agree      the same two activities, and a rule for each               -> the set corrects both, to the same type
         Manual     one activity the player assigns by hand        -> the explicit-assignment guard refuses it
         StaleJob   the rule names another job than the giver's    -> the job-changed guard refuses it
         StaleSet   the giver serves two buildings, the rule one   -> the equipment-set guard refuses it -->
  <ThingDef ParentName="BuildingBase">
    <defName>JoyRescueRule_CleanTable</defName>
    <label>rule witness clean table</label>
    <description>Test witness for the guards of the common fix set.</description>
    <graphicData>
      <texPath>Things/Building/Joy/ChessTable</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>false</rotatable>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.40</fillPercent>
    <socialPropernessMatters>true</socialPropernessMatters>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <JoyGainFactor>1</JoyGainFactor>
    </statBases>
    <building>
      <joyKind>Gaming_Cerebral</joyKind>
    </building>
  </ThingDef>
  <JobDef>
    <defName>JoyRescueRule_CleanUse</defName>
    <driverClass>JobDriver_SitFacingBuilding</driverClass>
    <reportString>playing at a witness table.</reportString>
    <joyDuration>4000</joyDuration>
    <joyMaxParticipants>2</joyMaxParticipants>
    <joyGainRate>1.0</joyGainRate>
    <joyKind>Gaming_Cerebral</joyKind>
  </JobDef>
  <JoyGiverDef>
    <defName>JoyRescueRule_CleanGiver</defName>
    <giverClass>JoyGiver_InteractBuildingSitAdjacent</giverClass>
    <baseChance>2</baseChance>
    <thingDefs><li>JoyRescueRule_CleanTable</li></thingDefs>
    <jobDef>JoyRescueRule_CleanUse</jobDef>
    <joyKind>Gaming_Cerebral</joyKind>
    <requiredCapacities><li>Manipulation</li></requiredCapacities>
  </JoyGiverDef>
